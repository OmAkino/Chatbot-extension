{
    "manifest_version": 3,
    "name": "AI Chatbot Extension",
    "description": "A togglable chatbot that appears in the bottom right of the screen with web scraping capabilities",
    "version": "1.0",
    "permissions": [
      "activeTab",
      "storage",
      "scripting",
      "downloads"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["chatbot.css"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["chatbot.html", "chatbot.js"],
        "matches": ["<all_urls>"]
      }
    ]
  }
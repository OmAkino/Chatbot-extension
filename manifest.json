{
  "manifest_version": 3,
  "name": "Chatbot Extension",
  "version": "1.0",
  "description": "A simple chatbot extension for web pages",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}